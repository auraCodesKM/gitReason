NODE_ENV=development
PORT=4000

# Create a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL below.
# Local:      http://localhost:4000/api/auth/github/callback
# Production: https://<your-render-service>.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Where the browser is sent back to after auth, and the allowed CORS
# origin(s) for the frontend. Comma-separated if you need more than one
# (e.g. a preview deploy alongside production). No trailing slash.
# Local:      http://localhost:5173
# Production: https://<your-app>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Required. Encrypts GitHub tokens at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Gemini API for repo analysis. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB connection string (required — the server will not start without it).
# Set it in ONE place: here, or in ../atlas-credentials.env (the file Atlas
# generates). npm start/dev load server/.env first, then ../atlas-credentials.env;
# a later file overrides an earlier one, and a real shell variable overrides both.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Never put it in client/.env or any VITE_* variable.
MONGODB_URI=

# Database name inside the cluster (optional, default: gitreason).
# Overrides any database name in the URI.
MONGODB_DB=

# Where uploaded documents are stored on disk (optional, default: server/uploads).
# Never inside a publicly served folder.
UPLOAD_DIR=
