PORT=4000

# Create a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Where the browser is sent back to after auth. In production, leave empty
# (the server serves the built client from the same origin).
CLIENT_ORIGIN=http://localhost:5173

# Required. Encrypts GitHub tokens at rest in the sessions table (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Gemini API for repo analysis. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
