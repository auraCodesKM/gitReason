NODE_ENV=development
PORT=4000

# Create a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL below.
# Local:      http://localhost:4000/api/auth/github/callback
# Production: https://<your-render-service>.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Where the browser is sent back to after auth, and the allowed CORS
# origin(s) for the frontend. Comma-separated if you need more than one
# (e.g. a preview deploy alongside production). No trailing slash.
# Local:      http://localhost:5173
# Production: https://<your-app>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Required. Encrypts GitHub tokens at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Gemini API for repo analysis. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database provider — "sqlite" (default, local file, used automatically
# when this is unset) or "turso" (production). Get a free Turso database at
# https://turso.tech — TURSO_DATABASE_URL and TURSO_AUTH_TOKEN only matter
# when DATABASE_PROVIDER=turso.
DATABASE_PROVIDER=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
